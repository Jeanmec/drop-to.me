{
  "name": "front",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "front/src",
  "projectType": "application",
  "tags": ["scope:front"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn next build",
        "cwd": "front"
      },
      "configurations": {
        "production": {}
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn next dev --turbo",
        "cwd": "front"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn lint",
        "cwd": "front"
      }
    }
  }
}
