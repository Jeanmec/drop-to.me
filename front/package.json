    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.4.1",
    "react-icons": "^5.5.0",
    "serve": "^14.2.7",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.8",
    "ua-parser-js": "^1.0.41",
    "zod": "^3.24.2",
